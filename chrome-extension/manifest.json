{
  "manifest_version": 3,
  "name": "GitHub IA Analyzer",
  "description": "Análise de repositórios GitHub para segurança, qualidade de código e boas práticas.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab", "scripting", "identity", "tabs"],
  "host_permissions": ["https://github.com/*", "https://*.supabase.co/*", "https://analise-de-repositorio.vercel.app/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GitHub IA Analyzer"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content/contentScript.js"]
    }
  ]
}
