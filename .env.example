# Exemplo de variáveis de ambiente para o backend Vercel

# GitHub OAuth / API
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# IA (Groq, Gemini ou outra API)
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# Valor opcional para usar em desenvolvimento local
VERCEL_URL=
